# Phase 2 Database (Supabase PostgreSQL)
# Example names only; never commit real credentials
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags
NEXT_PUBLIC_ENABLE_HISTORY="true"
NEXT_PUBLIC_USE_MOCK_DATA="true"
